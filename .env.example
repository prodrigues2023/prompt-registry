# Copy this file to `.env` (which is git-ignored) and set your real values there.
#   cp .env.example .env
#
# docker compose reads `.env` automatically and substitutes these into docker-compose.yml,
# so `make up` picks up whatever you set here. Defaults are used if a value is absent.

POSTGRES_USER=registry
POSTGRES_PASSWORD=registry
POSTGRES_DB=registry
